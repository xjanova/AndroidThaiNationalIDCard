<ui:Window x:Class="ThaiIDCardReader.Views.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:ThaiIDCardReader.ViewModels"
        Title="🔒 แก้ไขข้อมูลบัตรประชาชน (เจ้าหน้าที่ราชการเท่านั้น)"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Style>

        <Style x:Key="WarningBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF3CD"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning Header -->
        <Border Grid.Row="0" Style="{StaticResource WarningBannerStyle}">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#856404">
                    ⚠️ คำเตือนสำหรับเจ้าหน้าที่ราชการ
                </TextBlock>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#856404" FontSize="12">
                    • การแก้ไขข้อมูลบัตรประชาชนต้องได้รับอนุญาตจากหน่วยงานที่เกี่ยวข้องเท่านั้น<LineBreak/>
                    • ต้องมี Admin PIN และระบุเหตุผลในการแก้ไขทุกครั้ง<LineBreak/>
                    • ระบบจะบันทึก Audit Log ทุกการแก้ไข พร้อมชื่อเจ้าหน้าที่และเหตุผล<LineBreak/>
                    • การใช้งานโดยไม่ได้รับอนุญาตอาจมีโทษตามกฎหมาย
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Edit Forms -->
                <StackPanel Grid.Column="0">
                    <!-- Load Card Button -->
                    <Border Background="{DynamicResource SystemControlAcrylicElementBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📖 โหลดข้อมูลจากบัตร" Style="{StaticResource SectionTitleStyle}"/>
                            <Button Content="🔄 อ่านข้อมูลจากบัตร"
                                    Command="{Binding LoadCardDataCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="24,12"
                                    Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Name Section -->
                    <Border Background="{DynamicResource SystemControlAcrylicElementBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="👤 ชื่อ-นามสกุล" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="ชื่อ-นามสกุล (ภาษาไทย):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding EditNameTH, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="ชื่อ-นามสกุล (ภาษาอังกฤษ):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding EditNameEN, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Margin="0,0,0,12"/>

                            <Button Content="💾 บันทึกชื่อลงบัตร"
                                    Command="{Binding RequestAuthenticationCommand}"
                                    CommandParameter="อัปเดตชื่อ"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Address Section -->
                    <Border Background="{DynamicResource SystemControlAcrylicElementBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🏠 ที่อยู่" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="ที่อยู่ตามทะเบียนบ้าน:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MaxLength="160"
                                     Height="100"
                                     Margin="0,0,0,12"/>

                            <Button Content="💾 บันทึกที่อยู่ลงบัตร"
                                    Command="{Binding RequestAuthenticationCommand}"
                                    CommandParameter="อัปเดตที่อยู่"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Dates Section -->
                    <Border Background="{DynamicResource SystemControlAcrylicElementBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📅 วันที่" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="วันออกบัตร (YYYYMMDD):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding EditIssueDate, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="8"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="วันหมดอายุ (YYYYMMDD):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding EditExpireDate, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="8"
                                     Margin="0,0,0,12"/>

                            <Button Content="💾 บันทึกวันที่ลงบัตร"
                                    Command="{Binding RequestAuthenticationCommand}"
                                    CommandParameter="อัปเดตวันที่"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Panel - Photo -->
                <StackPanel Grid.Column="2">
                    <!-- Current Photo -->
                    <Border Background="{DynamicResource SystemControlAcrylicElementBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📷 รูปภาพปัจจุบัน" Style="{StaticResource SectionTitleStyle}"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="200"
                                    Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">
                                <Image Source="{Binding CurrentPhoto}"
                                       Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Edit Photo -->
                    <Border Background="{DynamicResource SystemControlAcrylicElementBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="🖼️ รูปภาพใหม่" Style="{StaticResource SectionTitleStyle}"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="200"
                                    Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
                                    Margin="0,0,0,12">
                                <Image Source="{Binding EditPhoto}"
                                       Stretch="Uniform"/>
                            </Border>

                            <Button Content="📁 เลือกรูปภาพ"
                                    Command="{Binding SelectPhotoCommand}"
                                    Margin="0,0,0,8"
                                    Padding="16,8"/>

                            <Button Content="💾 บันทึกรูปภาพลงบัตร"
                                    Command="{Binding RequestAuthenticationCommand}"
                                    CommandParameter="อัปเดตรูปภาพ"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:ProgressRing IsActive="{Binding IsProcessing}"
                                   Width="24" Height="24"
                                   Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 รีเซ็ต"
                            Command="{Binding ResetEditsCommand}"
                            Margin="0,0,8,0"
                            Padding="20,10"/>
                    <Button Content="💾 บันทึกทั้งหมดลงบัตร"
                            Command="{Binding RequestAuthenticationCommand}"
                            CommandParameter="อัปเดตทั้งหมด"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="20,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Authentication Dialog -->
        <Grid Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsAuthenticationDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource SystemControlAcrylicWindowBrush}"
                    CornerRadius="8"
                    Padding="32"
                    MaxWidth="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔐 ยืนยันตัวตนเจ้าหน้าที่"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="รหัสเจ้าหน้าที่:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding AdminId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"
                             ui:ControlHelper.PlaceholderText="เช่น: 1234567890123"/>

                    <TextBlock Text="Admin PIN (8 หลัก):" Style="{StaticResource LabelStyle}"/>
                    <ui:PasswordBox Password="{Binding AdminPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MaxLength="8"
                                  Margin="0,0,0,12"
                                  ui:ControlHelper.PlaceholderText="ใส่ Admin PIN"/>

                    <TextBlock Text="เหตุผลในการแก้ไข:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="80"
                             Margin="0,0,0,16"
                             ui:ControlHelper.PlaceholderText="ระบุเหตุผลในการแก้ไขข้อมูล"/>

                    <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                            Padding="12" CornerRadius="4" Margin="0,0,0,16">
                        <TextBlock TextWrapping="Wrap" Foreground="#856404" FontSize="11">
                            ⚠️ การแก้ไขข้อมูลจะถูกบันทึกใน Audit Log พร้อมรหัสเจ้าหน้าที่และเหตุผล
                        </TextBlock>
                    </Border>

                    <UniformGrid Rows="1" Columns="2">
                        <Button Content="ยกเลิก"
                              Command="{Binding CancelAuthenticationCommand}"
                              Margin="0,0,8,0"
                              Padding="20,10"/>
                        <Button Content="ยืนยันและบันทึก"
                              Command="{Binding AuthenticateAndWriteCommand}"
                              Style="{StaticResource AccentButtonStyle}"
                              Margin="8,0,0,0"
                              Padding="20,10"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:Window>
